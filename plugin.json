{
  "id": "prayerTimesEnhanced",
  "name": "Prayer Times Enhanced",
  "description": "Offline Islamic prayer times, with an Athan sound at prayer time and a Quran recitation browser/player",
  "version": "1.5.0",
  "author": "zeroaccess",
  "requires_dms": ">=1.2.0",
  "icon": "mosque",
  "type": "composite",
  "capabilities": [
    "dankbar-widget",
    "dash-tab",
    "dash-card"
  ],
  "components": {
    "widget": "./PrayerWidget.qml",
    "dash": "./PrayerDashTab.qml",
    "dashCard": "./PrayerDashCard.qml"
  },
  "settings": "./PrayerSettings.qml",
  "dash": {
    "title": "Prayer Times",
    "icon": "mosque",
    "card": {
      "title": "Prayer Times",
      "icon": "mosque",
      "w": 2,
      "h": 2,
      "minW": 2,
      "minH": 1,
      "maxW": 4,
      "maxH": 3
    },
    "options": [
      {
        "key": "use12H",
        "text": "12-hour format",
        "type": "toggle",
        "def": false
      },
      {
        "key": "showQuranInDash",
        "text": "Show Quran section",
        "type": "toggle",
        "def": true,
        "description": "Show or hide the Quran recitation section in the Prayer Times Dashboard tab"
      }
    ]
  },
  "permissions": [
    "settings_read",
    "settings_write",
    "process"
  ]
}
