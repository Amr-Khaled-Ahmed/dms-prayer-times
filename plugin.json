{
  "id": "prayerTimesEnhanced",
  "name": "Prayer Times Enhanced",
  "description": "Offline Islamic prayer times with a Dankbar countdown, Dashboard tab and card, Athan alerts, and a Quran recitation browser/player. Auto-location requests ip-api.com; Quran audio streams from mp3quran.net. Uses the Egyptian General Authority method.",
  "version": "1.7.0",
  "author": "Amr Khaled Ahmed",
  "requires_dms": ">=2.0.0",
  "icon": "mosque",
  "type": "composite",
  "capabilities": [
    "dankbar-widget",
    "dash-tab",
    "dash-card"
  ],
  "components": {
    "widget": "./PrayerWidget.qml",
    "dash": "./PrayerDashTab.qml",
    "dashCard": "./PrayerDashCard.qml"
  },
  "settings": "./PrayerSettings.qml",
  "dash": {
    "title": "Prayer Times",
    "icon": "mosque",
    "card": {
      "title": "Prayer Times",
      "icon": "mosque",
      "w": 2,
      "h": 2,
      "minW": 2,
      "minH": 2,
      "maxW": 4,
      "maxH": 3
    },
    "options": [
      {
        "key": "use12H",
        "text": "12-hour format",
        "type": "toggle",
        "def": false
      },
      {
        "key": "showQuranInDash",
        "text": "Show Quran section",
        "type": "toggle",
        "def": true,
        "description": "Show or hide the Quran recitation section in the Prayer Times Dashboard tab"
      },
      {
        "key": "tone",
        "text": "Card tone",
        "type": "choice",
        "def": "primary",
        "cardOnly": true,
        "choices": [
          {
            "value": "",
            "text": "Surface"
          },
          {
            "value": "primary",
            "text": "Primary"
          },
          {
            "value": "secondary",
            "text": "Secondary"
          },
          {
            "value": "tertiary",
            "text": "Tertiary"
          }
        ]
      }
    ]
  },
  "permissions": [
    "settings_read",
    "settings_write",
    "process"
  ]
}
